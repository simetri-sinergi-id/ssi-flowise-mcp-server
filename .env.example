# Required — Flowise connection
FLOWISE_BASE_URL=https://your-flowise-instance.example.com
FLOWISE_API_KEY=your-flowise-api-key-here

# Optional — request timeout in seconds (default: 60)
FLOWISE_TIMEOUT=60

# ── Tool configuration ─────────────────────────────────────────────────────
#
# Option A: explicit list of chatflows to expose as MCP tools.
# Each item needs "id" (chatflow UUID) and "name" (valid Python identifier).
# "description" is shown to the AI agent — be descriptive!
#
# FLOWISE_TOOLS=[
#   {
#     "id": "c7830e61-9629-4d56-9100-e49b0c2f17d2",
#     "name": "search_wiki",
#     "description": "Search the internal Wiki.js knowledge base for company policies, procedures, and technical guides."
#   }
# ]
FLOWISE_TOOLS=

# Option B: auto-discover ALL chatflows from the Flowise instance.
# Takes effect only when FLOWISE_TOOLS is empty.
FLOWISE_AUTO_DISCOVER=false

# ── Direct pgvector retrieval mode (recommended — bypasses Flowise prediction API) ─
# When all four PGVECTOR_* vars and OLLAMA_BASE_URL are set, the server queries
# pgvector directly instead of calling the Flowise prediction API.
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_DB=flowise
PGVECTOR_USER=flowise
PGVECTOR_PASS=CHANGE_ME
PGVECTOR_TABLE=wiki_docs
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
TOP_K=5

# ── Wiki.js GraphQL (optional — enables fetch_wiki_page tool) ─────────────
# When set, the server registers a `fetch_wiki_page` tool that fetches the
# full markdown content of any Wiki.js page by its path.
WIKIJS_GRAPHQL_URL=https://wiki.example.com/graphql
WIKIJS_API_KEY=your-wikijs-api-key-here
# Locale used for page lookups (default: id)
WIKIJS_LOCALE=id

# ── MCP server ─────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Transport: streamable-http (recommended for remote/Claude.ai), sse, or stdio
MCP_TRANSPORT=streamable-http

# Log level: debug | info | warning | error
MCP_LOG_LEVEL=info
